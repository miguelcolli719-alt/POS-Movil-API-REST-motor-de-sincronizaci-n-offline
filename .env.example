# ============================================================
# POS Móvil Backend — Variables de entorno
# Copiar a .env y completar. NUNCA commitear el archivo .env.
# El arranque es fail-fast: si algo falta o es inválido, el
# proceso termina mostrando el detalle (src/config/env.schema.js).
# ============================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000
# debug|info|warn|error (default: info en producción, debug en desarrollo)
LOG_LEVEL=debug

# --- Base de datos MySQL 8+ ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=pos_movil_residencia
# Desarrollo local: root o un usuario MySQL con permisos sobre el esquema.
# En producción se recomienda un usuario dedicado con privilegios mínimos.
DATABASE_USER=root
DATABASE_PASSWORD=

# Pool de conexiones
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100

# --- JWT ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Obligatorios en producción (mínimo 32 caracteres).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# --- Seguridad ---
BCRYPT_SALT_ROUNDS=12
# Orígenes permitidos separados por coma (sin wildcard para endpoints autenticados)
CORS_ORIGIN=http://localhost:5173
# Acceso directo: false. Producción recomendada: IP/CIDR del proxy, separados por coma.
# Un número de saltos (ej. 1) solo es seguro si TODAS las rutas tienen esa longitud.
# Nunca se acepta true, porque permitiría confiar ciegamente en X-Forwarded-*.
TRUST_PROXY=false

# --- Bloqueo de acceso por cuenta ---
# Cinco contraseñas incorrectas bloquean temporalmente la cuenta durante 15 minutos.
AUTH_ACCOUNT_MAX_FAILURES=5
AUTH_ACCOUNT_LOCK_SECONDS=900

# --- Seeder (npm run seed) ---
# Contraseña del usuario administrador inicial. Obligatoria en producción.
SEED_ADMIN_PASSWORD=

# --- Aprovisionamiento de dispositivo (npm run device:provision) ---
# approve|block. El secreto se exige solo para approve y nunca se registra.
DEVICE_ACTION=approve
DEVICE_IDENTIFIER=
DEVICE_SECRET=
# Obligatoria al crear; opcional si el dispositivo ya existe.
DEVICE_SUCURSAL_ID=
DEVICE_DESCRIPTION=
